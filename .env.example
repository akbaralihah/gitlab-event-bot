# timezone for the times in messages, e.g. Asia/Tashkent
TIMEZONE=UTC

# Telegram
TELEGRAM_BOT_TOKEN=
# public https address of this service: the Telegram webhook is set to PROJECT_URL/api/telegram/webhook
PROJECT_URL=https://your-domain.com
# telegram ids that become bot admins on startup: 123,456 or [123, 456]
TELEGRAM_ADMIN_IDS=

# Telegram secret_token (the GitLab signing token is entered in the admin panel).
# Only A-Z a-z 0-9 _ - ; empty = no check. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Database: DATABASE_URL or the DB_* variables
DATABASE_URL=
DB_NAME=gitlab_bot
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

# /admin panel (disabled while ADMIN_PASSWORD is empty)
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
